{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio-frontend",
  "framework": "angular",
  "routes": [
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|json|woff|woff2|ttf|eot|webp|pdf))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
